{
  "name": "office-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "start:storage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-storage.ps1",
    "predev:frontend": "npm run restart:document-service",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:python": "python services/document-service/run.py",
    "restart:document-service": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-document-service.ps1",
    "tauri:dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "build:desktop": "tauri build --no-bundle",
    "build:installer": "tauri build",
    "build:frontend": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
