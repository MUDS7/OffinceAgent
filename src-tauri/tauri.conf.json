{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OfficeAgent",
  "version": "0.1.0",
  "identifier": "com.officeagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OfficeAgent",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../services/document-service/app": "document-service/app",
      "../services/document-service/run.py": "document-service/run.py",
      "../services/document-service/requirements.txt": "document-service/requirements.txt",
      "../services/document-service/pyproject.toml": "document-service/pyproject.toml",
      "../services/document-service/.packages": "document-service/.packages"
    }
  }
}
